# Скопируй в .env и впиши свои значения. .env в .gitignore, в репозиторий не попадает.

# dadata.ru -> личный кабинет -> API ключи (нужен именно "API-ключ", секретный ключ не нужен для этого метода)
DADATA_API_KEY=

# vk.com/legalprivacy -> Управление -> Работа с API -> Ключи доступа (LongPoll, права: сообщения сообщества)
VK_BOT_TOKEN=

# Telegram-бот для доставки лидов (можно переиспользовать бота из scripts/telegram_api.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_ANDREW=
TELEGRAM_CHAT_ID_WIFE=
